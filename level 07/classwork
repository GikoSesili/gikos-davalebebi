# 2. ყველა ძირითადი მონაცემთა ტიპის მაგალითი
print("=== 2. მონაცემთა ტიპების მაგალითები ===\n")

a = 10                  # Integer (მთელი რიცხვი)
b = 10.5                # Float (ათწილადი რიცხვი)
c = "Hello"             # String (ტექსტი)
d = True                # Boolean (ლოგიკური)
e = [1, 2, 3]           # List (სია)
f = (1, 2, 3)           # Tuple (ტუპლი)
g = {"name": "Giorgi"}  # Dictionary (ლექსიკონი)
h = None                # NoneType

print("int:", a, type(a))
print("float:", b, type(b))
print("str:", c, type(c))
print("bool:", d, type(d))
print("list:", e, type(e))
print("tuple:", f, type(f))
print("dict:", g, type(g))
print("None:", h, type(h))
print()

